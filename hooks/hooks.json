{
  "description": "Auto-approve Trello plugin script execution",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/launch.cmd\" approve-trello",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "cmd /c \"\"${CLAUDE_PLUGIN_ROOT}/scripts/launch.cmd\" approve-trello\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/launch.cmd\" trello-state-reconciler",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "cmd /c \"\"${CLAUDE_PLUGIN_ROOT}/scripts/launch.cmd\" trello-state-reconciler\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/launch.cmd\" dependency-gate",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "cmd /c \"\"${CLAUDE_PLUGIN_ROOT}/scripts/launch.cmd\" dependency-gate\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/launch.cmd\" api-error-detector",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "cmd /c \"\"${CLAUDE_PLUGIN_ROOT}/scripts/launch.cmd\" api-error-detector\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/launch.cmd\" engineering-team-bridge",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "cmd /c \"\"${CLAUDE_PLUGIN_ROOT}/scripts/launch.cmd\" engineering-team-bridge\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/launch.cmd\" cascade-reminder",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "cmd /c \"\"${CLAUDE_PLUGIN_ROOT}/scripts/launch.cmd\" cascade-reminder\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
