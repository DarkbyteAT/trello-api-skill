{
  "name": "trello-api",
  "description": "Invoke any Trello REST API endpoint with auto-approved wrapper scripts, powered by the official OpenAPI spec with jq-based lookup",
  "version": "4.0.0",
  "author": {
    "name": "DarkbyteAT"
  },
  "repository": "https://github.com/DarkbyteAT/trello-api-skill",
  "license": "MIT",
  "keywords": [
    "trello",
    "api",
    "rest",
    "openapi",
    "curl"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/launch.cmd\" approve-trello"
          },
          {
            "type": "command",
            "command": "cmd /c \"\"${CLAUDE_PLUGIN_ROOT}/scripts/launch.cmd\" approve-trello\""
          }
        ]
      }
    ]
  }
}
